# ── Database ──────────────────────────────────────────────────────────────────
# Render provides DATABASE_URL automatically when you attach a Postgres instance.
# Format: jdbc:postgresql://host:5432/dbname?user=xxx&password=yyy
DATABASE_URL=jdbc:postgresql://localhost:5432/vestaai?user=vestaai&password=vestaai_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random 256-bit secret: openssl rand -base64 32
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars

# ── AI Microservice ───────────────────────────────────────────────────────────
# URL of the deployed FastAPI service (Render URL in production)
AI_SERVICE_URL=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://bite-back-ai.vercel.app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
