# ── Vite env vars ─────────────────────────────────────────────────────────────
# Leave VITE_API_URL empty for local dev (Vite proxy handles it via vite.config.js)
# In production (Vercel), leave EMPTY to use the Vercel reverse proxy (vercel.json)
VITE_API_URL=

# WebSocket URL — only needed if you bypass the Vercel proxy
VITE_WS_URL=
